{
  "name": "afterglow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:mcp": "node --env-file=.env.local --import tsx src/mcp/server.ts",
    "setup:connector": "node --env-file=.env.local --import tsx scripts/register-connector.ts",
    "dev:trueforge": "trueforge",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "setup:local": "node --import tsx scripts/init-local.ts",
    "setup:model": "node --env-file=.env.local --import tsx scripts/configure-model.ts",
    "setup:sandbox": "node --env-file=.env.local --import tsx scripts/configure-sandbox.ts",
    "setup:skill": "node --env-file=.env.local --import tsx scripts/register-skill.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@truefoundry/trueforge-sdk": "0.180.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.34.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@truefoundry/trueforge": "0.180.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
